# Copy this file to `.env` before running `docker compose up` (DEPLOYMENT.md).
# No real secrets belong here or in `.env` if you intend to commit it — `.env`
# is git-ignored; only this `.env.example` (placeholder values) is tracked.

# --- Postgres (shared by the app's audit log and MLflow's backend store) ---
POSTGRES_USER=solarops
POSTGRES_PASSWORD=solarops
POSTGRES_DB=solarops

# --- SolarOps API (read by pydantic-settings, SOLAROPS_ prefix) ---
# "local" (default if unset) keeps every adapter in-memory/fake, exactly the
# path the test suite always uses. "production" is what docker-compose.yml
# sets for the `api` service, switching to the real Redis/Postgres/MLflow
# below. Only meaningful when running outside compose (e.g. a bare
# `docker run`) — inside docker-compose.yml these are already set per
# service using the compose service names (`redis`, `postgres`, `mlflow`),
# not the values below.
SOLAROPS_ENV=local
SOLAROPS_REDIS_URL=redis://localhost:6379/0
SOLAROPS_POSTGRES_DSN=postgresql+psycopg://solarops:solarops@localhost:5432/solarops
SOLAROPS_MLFLOW_TRACKING_URI=http://localhost:5000

# Shared-secret auth on the mutating approval endpoints only (Phase 7a brief
# §3) — change this before exposing the API beyond local/demo use.
SOLAROPS_API_KEY=solarops-demo-key
