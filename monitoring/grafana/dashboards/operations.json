{
  "title": "SolarOps — Operations",
  "uid": "solarops-operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["solarops"],
  "panels": [
    {
      "id": 1,
      "title": "Commands issued (rate)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(solarops_commands_issued_total[5m]))",
          "legendFormat": "issued/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Commands blocked by safety (rate)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "red", "value": 0.001 }
      ] } }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(solarops_commands_blocked_by_safety_total[5m]))",
          "legendFormat": "blocked/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Approvals required (rate)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(solarops_approvals_required_total[5m]))",
          "legendFormat": "approvals required/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Success rate (completed / all terminal)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(solarops_commands_completed_total[15m])) / clamp_min(sum(rate(solarops_commands_completed_total[15m])) + sum(rate(solarops_commands_failed_total[15m])) + sum(rate(solarops_commands_rejected_total[15m])) + sum(rate(solarops_commands_blocked_by_safety_total[15m])), 1e-9)",
          "legendFormat": "success rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Commands completed vs failed (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(solarops_commands_completed_total[5m]))",
          "legendFormat": "completed",
          "refId": "A"
        },
        {
          "expr": "sum(rate(solarops_commands_failed_total[5m]))",
          "legendFormat": "failed",
          "refId": "B"
        },
        {
          "expr": "sum(rate(solarops_commands_blocked_by_safety_total[5m]))",
          "legendFormat": "blocked by safety",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "Commands rejected, by reason (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(solarops_commands_rejected_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Approval wait time (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(solarops_approval_wait_time_seconds_bucket[15m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(solarops_approval_wait_time_seconds_bucket[15m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Execution latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(solarops_execution_latency_seconds_bucket[15m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(solarops_execution_latency_seconds_bucket[15m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "API requests, by route (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "sum by (route, status) (rate(solarops_api_requests_total[5m]))",
          "legendFormat": "{{route}} [{{status}}]",
          "refId": "A"
        }
      ]
    }
  ]
}
