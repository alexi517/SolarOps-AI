{
  "title": "SolarOps — AI & Safety",
  "uid": "solarops-ai-safety",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["solarops"],
  "panels": [
    {
      "id": 1,
      "title": "Recommendation latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(solarops_recommendation_latency_seconds_bucket[15m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(solarops_recommendation_latency_seconds_bucket[15m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Forecasts produced, by kind (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (kind) (rate(solarops_forecasts_produced_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Anomalies detected, by severity (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (severity) (rate(solarops_anomalies_detected_total[5m]))",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Anomalies detected, by type (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (anomaly_type) (rate(solarops_anomalies_detected_total[5m]))",
          "legendFormat": "{{anomaly_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Commands blocked by safety (rate)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "red", "value": 0.001 }
      ] } }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(solarops_commands_blocked_by_safety_total[5m]))",
          "legendFormat": "blocked/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Verification failures (rate)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "red", "value": 0.001 }
      ] } }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(solarops_verification_failures_total[5m]))",
          "legendFormat": "verification failures/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Commands auto-rejected by low confidence (rate)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(solarops_commands_auto_rejected_by_confidence_total[5m]))",
          "legendFormat": "TODO — always 0 today, see metrics.py",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Registered model versions",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "solarops_registered_model_versions",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ]
}
